{
  "name": "exammode",
  "productName": "ExamMode",
  "version": "0.0.0",
  "author": "CodingSpaceKH",
  "private": true,
  "description": "Keeps lab computers inside an exam's own apps until students hand in, run live from the teacher's laptop",
  "main": "out/main/index.js",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && vite build --config vite.guard.config.mts",
    "start": "electron-vite preview",
    "lint": "eslint",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --project unit",
    "test:all": "vitest run --project unit --project integration --project acceptance --project component",
    "test:coverage": "npm run test:all -- --coverage",
    "test:windows": "vitest run --project windows",
    "check:quick": "npm run lint && npm run typecheck && npm test",
    "check": "npm run lint && npm run typecheck && npm run test:coverage && npm run build",
    "check:win": "npm run check && npm run test:windows",
    "e2e": "npm run build && playwright test",
    "ui:add": "node scripts/ui-add.mjs",
    "prepare": "git config core.hooksPath .githooks || true",
    "spike:win": "node spikes/windows/run-all.mjs",
    "db:generate": "drizzle-kit generate && node scripts/migrations.mjs",
    "class": "tsx scripts/class/cli.ts",
    "guard": "node out/guard/main.js"
  },
  "dependencies": {
    "busboy": "^1.6.0",
    "cn": "^0.5.2",
    "drizzle-orm": "^0.45.4",
    "input-otp": "^1.5.0",
    "koffi": "^3.3.7",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/busboy": "^1.5.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "5.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-kit": "^0.31.11",
    "electron": "45.2.3",
    "electron-builder": "^26.15.3",
    "electron-vite": "6.0.0",
    "eslint": "^10.14.0",
    "jsdom": "^30.1.3",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "5.1.0"
  }
}
